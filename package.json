{
  "name": "dsh-heipm",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "description": "DSH 项目管理面板：按项目浏览并管理约束、技能、经验流程与任务清单，配套经验流程提示词、quest-list 技能与 Markdown 表格样式。 · DSH project manager panel for constraints, skills, procedures and quest lists.",
  "license": "MIT",
  "author": "heiqisang (https://github.com/heiqisangx-crypto)",
  "homepage": "https://github.com/heiqisangx-crypto/dsh-heipm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heiqisangx-crypto/dsh-heipm.git"
  },
  "bugs": {
    "url": "https://github.com/heiqisangx-crypto/dsh-heipm/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "project-manager",
    "constraints",
    "skills",
    "procedures",
    "quest-list",
    "task-list",
    "markdown",
    "项目管理",
    "约束",
    "技能",
    "经验流程",
    "任务清单"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "exports": {
    ".": "./index.js",
    "./procedures": "./procedures/index.js",
    "./procedures/tools": "./procedures/tools.js",
    "./quest-list": "./quest-list/index.js",
    "./markdown": "./markdown/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./procedures/locale/*.json": "./procedures/locale/*.json",
    "./procedures/icon": "./procedures/icon.png",
    "./quest-list/locale/*.json": "./quest-list/locale/*.json",
    "./quest-list/icon": "./quest-list/icon.png",
    "./markdown/locale/*.json": "./markdown/locale/*.json",
    "./markdown/icon": "./markdown/icon.png",
    "./markdown/styles": "./markdown/styles.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.procedures.js",
    "client.quest.js",
    "procedures/index.js",
    "procedures/tools.js",
    "procedures/prompt.md",
    "quest-list/index.js",
    "quest-list/prompt.md",
    "quest-list/SKILL.md",
    "markdown/index.js",
    "markdown/styles.js",
    "markdown/icon.png",
    "markdown/locale/*.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "procedures/locale/*.json",
    "procedures/icon.png",
    "quest-list/locale/*.json",
    "quest-list/icon.png",
    "templates/*.md",
    "templates/tools/*",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/HOST_CONTRACT.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/host.mjs && node test/procedures.mjs && node test/quest-list.mjs && node test/markdown.mjs && node test/workspace-menu.mjs && node test/workspace-open.mjs && node test/open-folder.mjs && node test/open-folder-route.mjs && node test/ui-contract.mjs && node test/stats.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
